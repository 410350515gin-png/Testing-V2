    function selectAppIcon(icon) {
        localStorage.setItem('v3_selected_app_icon', icon.id);
        
        // 將 SVG 轉為 Data URI 設定為 apple-touch-icon
        const svgBlob = new Blob([icon.svg], {type: 'image/svg+xml;charset=utf-8'});
