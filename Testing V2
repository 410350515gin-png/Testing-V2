    function renderMainThemeOptions() {
        const container = document.getElementById('themeOptions');
        container.innerHTML = '';
        Object.keys(THEMES).forEach(key => {
            const t = THEMES[key];
            const card = document.createElement('div');
            card.className = `opt-card ${key === (semesters[currentSemesterKey]?.theme || 'oat') ? 'selected' : ''}`;
            card.innerText = t.name;
            card.onclick = () => {
                setSemesterTheme(key);
                renderMainThemeOptions();
            };
            container.appendChild(card);
        });
    }

    function saveToLocalStorageSilent() {
        localStorage.setItem('v3_clean_semesters', JSON.stringify(semesters));
        if (pinnedSemesterKey) {
            localStorage.setItem('v3_clean_pinned', pinnedSemesterKey);
        } else {
            localStorage.removeItem('v3_clean_pinned');
        }
    }

    function togglePinSemester(semKey) {
        if (pinnedSemesterKey === semKey) {
            pinnedSemesterKey = null;
        } else {
            pinnedSemesterKey = semKey;
            
            const newSemesters = {};
            newSemesters[semKey] = semesters[semKey];
            Object.keys(semesters).forEach(k => {
                if (k !== semKey) newSemesters[k] = semesters[k];
            });
            semesters = newSemesters;
        }
        saveToLocalStorageSilent();
        renderSemesters();
    }

    function moveSemesterIndex(semKey, direction, event) {
        event.stopPropagation();
        if (semKey === pinnedSemesterKey) return;

        const keys = Object.keys(semesters);
        const idx = keys.indexOf(semKey);
        if (idx === -1) return;

        const newIdx = idx + direction;
        const minIndex = (pinnedSemesterKey && semesters[pinnedSemesterKey]) ? 1 : 0;
        if (newIdx < minIndex || newIdx >= keys.length) return;

        const targetKey = keys[newIdx];
        keys[idx] = targetKey;
        keys[newIdx] = semKey;

        const newSemesters = {};
        keys.forEach(k => {
            newSemesters[k] = semesters[k];
        });

        semesters = newSemesters;
        renderSemesters();
        saveToLocalStorageSilent();
    }

    function renderSemesters() {
        const container = document.getElementById('semesterList');
        container.innerHTML = '';
        
        const keys = Object.keys(semesters);
        
        if (keys.length === 0) {
            container.innerHTML = `<div style="text-align:center; padding: 20px; font-size:0.85rem; color:var(--text-sub);">目前還沒有任何學期課表唷！<br>請在上方建立第一個學期～</div>`;
            document.getElementById('currentSemesterTitle').innerText = '';
            return;
        }

        const minMoveIndex = (pinnedSemesterKey && semesters[pinnedSemesterKey]) ? 1 : 0;

        keys.forEach((key, index) => {
            const isCurrent = (key === currentSemesterKey);
            const isPinned = (key === pinnedSemesterKey);
            const isExpanded = (key === expandedSemesterKey);
            const currentThemeKey = semesters[key]?.theme || 'oat';
            const themeObj = THEMES[currentThemeKey] || THEMES['oat'];

            const card = document.createElement('div');
            card.className = `semester-card ${isCurrent ? 'active' : ''} ${isPinned ? 'pinned' : ''} ${isExpanded ? 'expanded' : ''}`;

            card.ondblclick = () => togglePinSemester(key);

            let themeButtonsHTML = '';
            Object.keys(THEMES).forEach(tKey => {
                themeButtonsHTML += `
                    <div class="opt-card ${tKey === currentThemeKey ? 'selected' : ''}" 
                         style="font-size: 0.72rem; padding: 4px;"
                         onclick="event.stopPropagation(); setSpecificSemesterTheme('${key}', '${tKey}')">
                        ${THEMES[tKey].name}
                    </div>
                `;
            });

            let moveButtonsHTML = '';
            if (!isPinned) {
                moveButtonsHTML = `
                    <div class="move-btn-group" onclick="event.stopPropagation()">
                        <button class="btn-move" onclick="moveSemesterIndex('${key}', -1, event)" ${index <= minMoveIndex ? 'disabled' : ''}>▲</button>
                        <button class="btn-move" onclick="moveSemesterIndex('${key}', 1, event)" ${index === keys.length - 1 ? 'disabled' : ''}>▼</button>
                    </div>
                `;
            }

            card.innerHTML = `
                <div class="semester-card-header" onclick="toggleSemesterAccordion('${key}')">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <span>${key}</span>
                        ${isPinned ? '<span style="font-size:0.85rem;">📌</span>' : ''}
                    </div>
                    <div style="display:flex; align-items:center; gap:4px;">
                        ${moveButtonsHTML}
                        <span style="font-size: 0.8rem; opacity: 0.7; margin-left: 4px;">${isExpanded ? '▴' : '▾'}</span>
                    </div>
                </div>
                <div class="semester-card-body" style="background: ${themeObj.card}; border-top-color: ${themeObj.border};">
                    <div class="form-group" style="margin-bottom: 8px;">
                        <label style="font-size:0.75rem;">修改學期名稱：</label>
                        <input type="text" id="input-sem-name-${key}" value="${key}" style="padding: 4px 8px; font-size: 0.8rem;" onclick="event.stopPropagation()">
                        <button class="btn btn-save" style="padding: 4px; font-size: 0.75rem; margin-top: 4px; background:${themeObj.primary};" onclick="event.stopPropagation(); renameSemester('${key}')">更新學期名稱</button>
                    </div>

                    <div style="font-size:0.75rem; font-weight:bold; margin-bottom: 4px;">學期配色風格 (即時預覽)：</div>
                    <div class="option-cards" style="grid-template-columns: repeat(4, 1fr); gap: 4px; margin-bottom: 10px;">
                        ${themeButtonsHTML}
                    </div>

                    ${!isCurrent ? `<button class="btn btn-submit" style="width:100%; padding: 6px; font-size:0.8rem; background:${themeObj.primary};" onclick="event.stopPropagation(); switchSemesterDirect('${key}')">切換至此學期</button>` : `<div style="text-align:center; font-size:0.75rem; color:${themeObj.primary}; font-weight:bold;">★ 當前使用中學期</div>`}

                    ${Object.keys(semesters).length > 1 ? `<button class="btn btn-danger" style="width:100%; padding: 4px; font-size:0.75rem; margin-top:6px;" onclick="event.stopPropagation(); deleteSemester('${key}')">移除此學期</button>` : ''}
                </div>
            `;
            container.appendChild(card);
        });

        document.getElementById('currentSemesterTitle').innerText = currentSemesterKey ? `(${currentSemesterKey})` : '';
        renderMainThemeOptions();
    }

    function switchSemesterDirect(key) {
        switchSemester(key);
        toggleSidebar();
    }

    function toggleSemesterAccordion(key) {
        expandedSemesterKey = (expandedSemesterKey === key) ? null : key;
        renderSemesters();
    }

    function setSpecificSemesterTheme(semKey, themeKey) {
        if (semesters[semKey]) {
            semesters[semKey].theme = themeKey;
            if (semKey === currentSemesterKey) {
                setTheme(themeKey);
            }
            saveToLocalStorageSilent();
            renderSemesters();
        }
    }

    function renameSemester(oldKey) {
        const inputEl = document.getElementById(`input-sem-name-${oldKey}`);
        const newTitle = inputEl ? inputEl.value.trim() : '';
        if(!newTitle) return alert('學期名稱不能留白唷！');
        if(newTitle === oldKey) return;
        if(semesters[newTitle]) return alert('已經有同名的學期囉！');

        const newSemesters = {};
        Object.keys(semesters).forEach(k => {
            if (k === oldKey) newSemesters[newTitle] = semesters[oldKey];
            else newSemesters[k] = semesters[k];
        });

        semesters = newSemesters;
        if (currentSemesterKey === oldKey) currentSemesterKey = newTitle;
        if (pinnedSemesterKey === oldKey) {
            pinnedSemesterKey = newTitle;
            localStorage.setItem('v3_clean_pinned', newTitle);
        }
        if (expandedSemesterKey === oldKey) expandedSemesterKey = newTitle;

        renderSemesters();
        saveToLocalStorageSilent();
    }

    function setSemesterTheme(themeKey) {
        if (semesters[currentSemesterKey]) {
            semesters[currentSemesterKey].theme = themeKey;
            setTheme(themeKey);
            renderSemesters();
        }
    }

    function addSemester() {
        const input = document.getElementById('newSemesterName');
        const name = input.value.trim();
        if (!name) return alert('請填寫新學期的名字唷！');
        if (semesters[name]) return alert('這個學期已經建立過了唷！');
        semesters[name] = { courses: [], theme: 'oat' };
        input.value = '';
        expandedSemesterKey = name;
        switchSemester(name);
    }

    function switchSemester(key) {
        currentSemesterKey = key;
        const semData = semesters[key] || { courses: [], theme: 'oat' };
        courses = Array.isArray(semData) ? semData : (semData.courses || []);
        
        if (semData.theme) setTheme(semData.theme);

        history = []; historyIndex = -1;
        recordState();
        renderSemesters();
        updateUI();
    }

    function deleteSemester(key) {
        if (confirm(`確定要刪除「${key}」學期嗎？`)) {
            delete semesters[key];
            if (pinnedSemesterKey === key) {
                pinnedSemesterKey = null;
                localStorage.removeItem('v3_clean_pinned');
            }
            currentSemesterKey = Object.keys(semesters)[0] || '';
            if (currentSemesterKey) {
                switchSemester(currentSemesterKey);
            } else {
                courses = [];
                updateUI();
                renderSemesters();
            }
            saveToLocalStorageSilent();
        }
    }

    function setTheme(themeKey, el) {
        if (el) {
            document.querySelectorAll('#themeOptions .opt-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
        }
        const t = THEMES[themeKey] || THEMES['oat'];
        const root = document.documentElement;
        root.style.setProperty('--bg-color', t.bg);
        root.style.setProperty('--card-bg', t.card);
        root.style.setProperty('--panel-bg', t.panel);
        root.style.setProperty('--c-submit', t.primary);
        root.style.setProperty('--c-blue', t.primary);
        root.style.setProperty('--text-main', t.text);
        root.style.setProperty('--text-sub', t.sub);
        root.style.setProperty('--border-color', t.border);
        root.style.setProperty('--grid-border', t.grid);
    }

    function setFontFamily(font, el) {
        if(el) {
            el.parentNode.querySelectorAll('.opt-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
        }
        document.documentElement.style.setProperty('--font-family-custom', font);
    }

    function recordState() {
        if (!currentSemesterKey) return;
        history = history.slice(0, historyIndex + 1);
        history.push(JSON.stringify(courses));
        historyIndex++;
        if (semesters[currentSemesterKey]) {
            if (Array.isArray(semesters[currentSemesterKey])) {
                semesters[currentSemesterKey] = { courses: courses, theme: 'oat' };
            } else {
                semesters[currentSemesterKey].courses = courses;
            }
        }
        updateHistoryButtons();
        saveToLocalStorageSilent();
    }

    function updateHistoryButtons() {
        document.getElementById('btnUndo').disabled = historyIndex <= 0;
        document.getElementById('btnRedo').disabled = historyIndex >= history.length - 1;
    }

    function undo() {
        if (historyIndex > 0) {
            historyIndex--;
            courses = JSON.parse(history[historyIndex]);
            if (semesters[currentSemesterKey]) semesters[currentSemesterKey].courses = courses;
            updateUI(); updateHistoryButtons();
            saveToLocalStorageSilent();
        }
    }

    function redo() {
        if (historyIndex < history.length - 1) {
            historyIndex++;
            courses = JSON.parse(history[historyIndex]);
            if (semesters[currentSemesterKey]) semesters[currentSemesterKey].courses = courses;
            updateUI(); updateHistoryButtons();
            saveToLocalStorageSilent();
        }
    }

    function handleAddCourse() {
        if (!currentSemesterKey) return alert('請先建立一個學期課表唷！');
        const name = document.getElementById('cName').value.trim();
        if (!name) return alert('請填寫課程名稱唷！');
        const selectedPeriods = Array.from(document.querySelectorAll('input[name="periods"]:checked')).map(el => el.value);
        if (selectedPeriods.length === 0) return alert('請至少勾選一個上課節次唷！');

        const inputCredits = document.getElementById('cCredits').value.trim();
        const credits = inputCredits !== '' ? parseFloat(inputCredits) : selectedPeriods.length;
        const courseType = document.getElementById('cType').value;

        const newCourse = {
            id: Date.now().toString(),
            name: name,
            code: document.getElementById('cCode').value.trim(),
            teacher: document.getElementById('cTeacher').value.trim(),
            room: document.getElementById('cRoom').value.trim(),
            day: parseInt(document.getElementById('cDay').value),
            weekType: document.getElementById('cWeekType').value,
            borderStyle: document.getElementById('cBorderStyle').value,
            customColor: selectedCustomColor,
            periods: selectedPeriods,
            credits: credits,
            courseType: courseType,
            url: '', notes: ''
        };

        courses.push(newCourse);
        recordState();
        updateUI();

        document.getElementById('cName').value = '';
        document.getElementById('cCode').value = '';
        document.getElementById('cTeacher').value = '';
        document.getElementById('cRoom').value = '';
        document.getElementById('cCredits').value = '';
        document.querySelectorAll('input[name="periods"]').forEach(cb => cb.checked = false);
    }

    function isConflict(c1, c2) {
        if ((c1.weekType === '單週' && c2.weekType === '雙週') || (c1.weekType === '雙週' && c2.weekType === '單週')) return false;
        return true;
    }

    function updateUI() {
        PERIODS.forEach(p => DAYS.forEach(d => {
            const el = document.getElementById(`cell-${d}-${p}`);
            if(el) el.innerHTML = '';
        }));

        const gridMap = {};
        courses.forEach(course => {
            course.periods.forEach(p => {
                const key = `${course.day}-${p}`;
                if (!gridMap[key]) gridMap[key] = [];
                gridMap[key].push(course);
            });
        });

        Object.keys(gridMap).forEach(key => {
            const [day, period] = key.split('-');
            const cell = document.getElementById(`cell-${day}-${period}`);
            if(!cell) return;
            const cellCourses = gridMap[key];

            cellCourses.forEach((c, idx) => {
                let hasConflict = false;
                for (let i = 0; i < cellCourses.length; i++) {
                    if (i !== idx && isConflict(c, cellCourses[i])) { hasConflict = true; break; }
                }

                const isChecked = selectedCourseCodes.has(c.id) ? 'checked' : '';
                const color = c.customColor || CARD_COLORS[0];
                
                let infoHTML = '';
                if (c.code) infoHTML += `<div>代碼: ${c.code}</div>`;
                if (c.teacher) infoHTML += `<div>教師: ${c.teacher}</div>`;
                if (c.room) infoHTML += `<div>教室: ${c.room}</div>`;

                let borderCSS = 'border-left: 3.5px solid ' + color.border + ';';
                if (c.borderStyle === 'double') borderCSS = 'border: 3px double ' + color.border + ';';
                else if (c.borderStyle === 'dashed') borderCSS = 'border: 1.5px dashed ' + color.border + ';';
                else if (c.borderStyle === 'none') borderCSS = 'border: none;';

                const cardHTML = `
                    <div class="course-item" 
                         style="background: ${color.bg}; ${borderCSS}"
                         onclick="openCourseDetailModal('${c.id}', event)">
                        <div class="course-header">
                            <div class="course-title-wrap">
                                <span class="course-title">${c.name}</span>
                                ${hasConflict ? '<span class="conflict-badge">衝堂</span>' : ''}
                            </div>
                            <input type="checkbox" class="course-checkbox" onchange="toggleCourseSelect('${c.id}', this.checked)" onclick="event.stopPropagation()" ${isChecked}>
                        </div>
                        ${infoHTML}
                        <div><span class="badge">${c.weekType}</span></div>
                    </div>
                `;
                cell.innerHTML += cardHTML;
            });
        });

        calculateStats();
        checkConflicts(gridMap);
    }

    function calculateStats() {
        let totalPeriods = 0;
        let totalCredits = 0;
        let requiredCredits = 0;
        let electiveCredits = 0;
        let generalCredits = 0;

        courses.forEach(c => {
            totalPeriods += c.periods ? c.periods.length : 0;
            const cred = typeof c.credits === 'number' ? c.credits : (c.periods ? c.periods.length : 0);
            totalCredits += cred;

            if (c.courseType === '必修') requiredCredits += cred;
            else if (c.courseType === '選修') electiveCredits += cred;
            else if (c.courseType === '通識') generalCredits += cred;
        });

        document.getElementById('statTotalPeriods').innerText = totalPeriods;
        document.getElementById('statTotalCredits').innerText = totalCredits;
        document.getElementById('statRequiredCredits').innerText = `必修 ${requiredCredits}`;
        document.getElementById('statElectiveCredits').innerText = `選修 ${electiveCredits}`;
        document.getElementById('statGeneralCredits').innerText = `通識 ${generalCredits}`;
    }

    function openCourseDetailModal(id, e) {
        if (e.target.tagName === 'INPUT') return;
        currentDetailCourseId = id;
        const c = courses.find(item => item.id === id);
        if(!c) return;

        document.getElementById('editName').value = c.name || '';
        document.getElementById('editRoom').value = c.room || '';
        document.getElementById('editCode').value = c.code || '';
        document.getElementById('editTeacher').value = c.teacher || '';
        document.getElementById('editCredits').value = typeof c.credits === 'number' ? c.credits : (c.periods ? c.periods.length : 0);
        document.getElementById('editType').value = c.courseType || '必修';
        document.getElementById('editBorderStyle').value = c.borderStyle || 'solid';

        document.getElementById('detailUrl').value = c.url || '';
        document.getElementById('detailNotes').value = c.notes || '';

        initEditCardColorPicker(c.customColor);
        document.getElementById('detailModal').classList.add('active');
    }

    function saveCourseDetails() {
        const c = courses.find(item => item.id === currentDetailCourseId);
        if(c) {
            const newName = document.getElementById('editName').value.trim();
            if(!newName) return alert('課程名稱不能留白唷！');

            c.name = newName;
            c.room = document.getElementById('editRoom').value.trim();
            c.code = document.getElementById('editCode').value.trim();
            c.teacher = document.getElementById('editTeacher').value.trim();
            
            const credVal = document.getElementById('editCredits').value.trim();
            c.credits = credVal !== '' ? parseFloat(credVal) : (c.periods ? c.periods.length : 0);
            c.courseType = document.getElementById('editType').value;

            c.borderStyle = document.getElementById('editBorderStyle').value;
            c.customColor = editCustomColor;

            c.url = document.getElementById('detailUrl').value.trim();
            c.notes = document.getElementById('detailNotes').value.trim();

            recordState();
            updateUI();
        }
        closeModal('detailModal');
    }

    function openCourseUrl() {
        const url = document.getElementById('detailUrl').value.trim();
        if (url) window.open(url, '_blank');
        else alert('尚未輸入網址連結唷！');
    }

    function toggleCourseSelect(id, isChecked) {
        if (isChecked) selectedCourseCodes.add(id);
        else selectedCourseCodes.delete(id);
        updateUI();
    }

    function deleteSelectedCourses() {
        if (selectedCourseCodes.size === 0) return alert('請先勾選想要移除的課程唷！');
        if (confirm(`確定要將選取的 ${selectedCourseCodes.size} 門課程整堂刪除嗎？`)) {
            courses = courses.filter(c => !selectedCourseCodes.has(c.id));
            selectedCourseCodes.clear();
            recordState(); 
            updateUI();
        }
    }

    function deleteCourseById(id) {
        courses = courses.filter(c => c.id !== id);
        recordState(); 
        updateUI();
    }

    function checkConflicts(gridMap) {
        const conflictBox = document.getElementById('conflictBox');
        const conflictList = document.getElementById('conflictList');
        conflictList.innerHTML = '';
        let hasConflict = false;
        const dayNames = ['', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六', '星期日'];

        Object.keys(gridMap).forEach(key => {
            const list = gridMap[key];
            if (list.length > 1) {
                const conflictingCourses = new Set();
                for (let i = 0; i < list.length; i++) {
                    for (let j = i + 1; j < list.length; j++) {
                        if (isConflict(list[i], list[j])) {
                            conflictingCourses.add(list[i]);
                            conflictingCourses.add(list[j]);
                        }
                    }
                }

                if (conflictingCourses.size > 0) {
                    hasConflict = true;
                    const [day, period] = key.split('-');

                    let groupHTML = `
                        <div class="conflict-group">
                            <div class="conflict-group-title">📌 ${dayNames[day]} 第 ${period} 節 發生衝堂：</div>
                    `;

                    conflictingCourses.forEach(c => {
                        let detail = c.teacher ? `${c.teacher}` : '';
                        if(c.room) detail += ` (${c.room})`;

                        groupHTML += `
                            <div class="conflict-row-item">
                                <span><strong>${c.name}</strong> ${c.code ? `(${c.code})` : ''} ${detail} [<b style="color: var(--c-red);">${c.weekType}</b>]</span>
                                <button class="btn btn-danger" style="padding: 2px 8px; font-size: 0.72rem;" onclick="deleteCourseById('${c.id}')">移除此課</button>
                            </div>
                        `;
                    });

                    groupHTML += `</div>`;
                    conflictList.innerHTML += groupHTML;
                }
            }
        });

        if (hasConflict) {
            conflictBox.style.display = 'block';
            document.getElementById('conflictBody').classList.remove('collapsed');
            document.getElementById('conflictToggleBtn').innerText = '收起 ▴';
        } else {
            conflictBox.style.display = 'none';
        }
    }

    function saveToLocalStorage() {
        saveToLocalStorageSilent();
        alert('課表資料已幫你成功儲存至瀏覽器囉！');
    }

    function openExportModal(e) {
        if (e) e.stopPropagation();
        document.getElementById('exportScheduleName').value = currentSemesterKey || '我的學期課表';
        const modal = document.getElementById('exportModal');
        if (modal) modal.classList.add('active');
    }

    function selectExportSize(ratio, el) {
        selectedExportRatio = ratio;
        el.parentNode.querySelectorAll('.opt-card').forEach(c => c.classList.remove('selected'));
        el.classList.add('selected');
    }

    /* ✨ 截圖圖片標題（僅保留第一行自訂名稱大字，移除第二行） */
    function executeExport() {
        const customName = document.getElementById('exportScheduleName').value.trim() || '我的學期課表';
        closeModal('exportModal');

        const titleBox = document.getElementById('screenshotTitleBox');
        const mainTitle = document.getElementById('screenshotMainTitle');
        const target = document.getElementById('scheduleTableCard');

        mainTitle.innerText = customName;
        titleBox.style.display = 'block';

        const checkboxes = document.querySelectorAll('.course-checkbox');
        checkboxes.forEach(cb => cb.style.display = 'none');

        let origPadding = target.style.padding;
        if (selectedExportRatio === 'iphone') target.style.padding = '30px 16px 60px 16px';
        else if (selectedExportRatio === 'ipad') target.style.padding = '24px 30px';

        html2canvas(target, {
            scale: 2,
            backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--card-bg').trim(),
            useCORS: true
        }).then(canvas => {
            checkboxes.forEach(cb => cb.style.display = 'inline-block');
            titleBox.style.display = 'none';
            target.style.padding = origPadding;

            const link = document.createElement('a');
            link.download = `${customName}_課表截圖.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
        }).catch(() => {
            checkboxes.forEach(cb => cb.style.display = 'inline-block');
            titleBox.style.display = 'none';
            target.style.padding = origPadding;
            alert('圖片繪製失敗，請再試一次唷！');
        });
    }

    window.onload = () => {
        initCardColorPicker();
        renderAppIconGrid();
        
        ['v2_semesters_data', 'v2_pinned_semester', 'my_semesters_data', 'my_pinned_semester'].forEach(k => localStorage.removeItem(k));

        const savedTitle = localStorage.getItem('my_app_title_name');
        if (savedTitle) {
            appTitleName = savedTitle;
            document.getElementById('mainAppNameInput').value = savedTitle;
        }

        const savedCollapsed = localStorage.getItem('v3_course_form_collapsed');
        if (savedCollapsed === 'true') {
            isCourseFormCollapsed = true;
            document.getElementById('courseFormBody').classList.add('collapsed');
            document.getElementById('courseFormToggleBtn').innerText = '展開 ▾';
        }

        const savedPinned = localStorage.getItem('v3_clean_pinned');
        if (savedPinned) {
            pinnedSemesterKey = savedPinned;
        }

        const savedData = localStorage.getItem('v3_clean_semesters');
        if (savedData) {
            try {
                semesters = JSON.parse(savedData);
            } catch(e){}
        }

        const keys = Object.keys(semesters);
        
        if (keys.length === 0) {
            const defaultKey = '未命名學期';
            semesters = {};
            semesters[defaultKey] = { courses: [], theme: 'oat' };
            currentSemesterKey = defaultKey;
        } else {
            if (pinnedSemesterKey && semesters[pinnedSemesterKey]) {
                currentSemesterKey = pinnedSemesterKey;
            } else {
                currentSemesterKey = keys[0];
            }
        }

        switchSemester(currentSemesterKey);
    };
</script>

</body>
</html>
