            body.classList.add('collapsed');
            btn.innerText = '展開 ▾';
        } else {
            body.classList.remove('collapsed');
            btn.innerText = '收起 ▴';
        }

        localStorage.setItem('v3_course_form_collapsed', isCourseFormCollapsed ? 'true' : 'false');
    }

