        const container = document.getElementById('cardColorPicker');
        container.innerHTML = '';
        CARD_COLORS.forEach((color, idx) => {
            const dot = document.createElement('div');
            dot.className = `color-dot ${idx === 0 ? 'selected' : ''}`;
