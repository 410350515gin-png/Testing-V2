    function initEditCardColorPicker(selectedColorObj) {
        const container = document.getElementById('editCardColorPicker');
        container.innerHTML = '';
        editCustomColor = selectedColorObj || CARD_COLORS[0];

        CARD_COLORS.forEach(color => {
            const dot = document.createElement('div');
