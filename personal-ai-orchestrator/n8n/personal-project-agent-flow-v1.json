          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-research",
      "name": "Need Research?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        -120
      ]
    },
    {
      "parameters": {
        "url": "https://api.perplexity.ai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.PERPLEXITY_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'sonar',messages:[{role:'system',content:'You are a research specialist. Return concise findings with sources.'},{role:'user',content:$json.user_instruction}]}) }}",
        "options": {}
      },
      "id": "perplexity",
      "name": "Perplexity Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        -200
      ],
      "disabled": true,
      "notes": "Enable after PERPLEXITY_API_KEY is configured. Until then, Claude-native research remains the fallback."
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({json:{...item.json,research_result:item.json.research_result||\"Use Claude-native research fallback until Perplexity node is enabled.\",writer_task:\"Draft or revise only reversible content. Never overwrite canonical files without rollback.\"}}));"
      },
      "id": "writer",
      "name": "Claude Writer Adapter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -20
      ],
      "notes": "Adapter placeholder. V1 execution remains Claude Project; later replace with supported Anthropic API/connector."
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({json:{...item.json,review_packet:{instruction:\"Independent second-model review\",focus:[\"methodology\",\"logic\",\"cross-file consistency\",\"risk\"],source:\"Drive/_handoff\"}}}));"
      },
      "id": "review-packet",
      "name": "Build ChatGPT Review Packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "const highRisk = Boolean($json.high_risk); return [{json:{...$json,human_gate:highRisk?\"waiting_human\":\"approved_automatically\",status:highRisk?\"waiting_human\":\"running\"}}];"
      },
      "id": "human-gate",
      "name": "Human Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        -20
      ],
      "notes": "Replace with Send and Wait / form approval when n8n runtime is connected."
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({json:{...item.json,status:item.json.human_gate===\"waiting_human\"?\"waiting_human\":\"completed\",final_summary:{project:item.json.project_name,run_id:item.json.run_id,next:item.json.human_gate===\"waiting_human\"?\"Await user decision\":\"Update Notion/Drive/GitHub safely\"}}}));"
      },
      "id": "integrator",
      "name": "Final Integrator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        -20
      ]
    }
