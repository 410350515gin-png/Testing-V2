# Copy to .env on the private host. Never commit real secrets.

# n8n
N8N_HOST=
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=

# OpenClaw
OPENCLAW_GATEWAY_TOKEN=

# Notion
NOTION_TOKEN=
NOTION_PROJECT_DATABASE_ID=
NOTION_DECISION_DATABASE_ID=

# Google Drive / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_PROJECT_FOLDER_ID=

# Optional external research
PERPLEXITY_API_KEY=
PERPLEXITY_MONTHLY_BUDGET_USD=5

# Model authentication is configured on the host.
# Do not commit OAuth tokens or provider secrets here.
